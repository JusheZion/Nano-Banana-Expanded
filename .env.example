# ARCS Universal API Bridge & Data Persistence
# Copy this file to .env and fill in your real values there.
# Never put real keys in .env.example (it may be committed to git).

# Supabase (optional; if missing, save falls back to localStorage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Gemini Image API (Nano Banana 2 / Pro)
VITE_GEMINI_API_KEY=your-gemini-api-key
