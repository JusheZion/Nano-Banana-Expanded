# ARCS Universal API Bridge & Data Persistence
# Copy this file to .env and fill in your real values there.
# Never put real keys in .env.example (it may be committed to git).

# Supabase (optional; if missing, save falls back to localStorage)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
#
# Auth: Dashboard → Authentication → URL configuration — set Site URL + Redirect URLs
# (production + http://localhost:5173 for Vite). Enable Email provider for password sign-in.
# Edge Function writer-tools uses verify_jwt; signed-in users get JWT on invoke automatically.

# Gemini API (image + text). Create a key: https://aistudio.google.com/apikey
VITE_GEMINI_API_KEY=your-gemini-api-key
#
# Writers' Workshop (Edge Function writer-tools) does NOT read VITE_* vars. It only sees Supabase secrets:
#   supabase link --project-ref <your-project-ref>
#   supabase secrets set GEMINI_API_KEY=your-gemini-api-key
# Use the same string as VITE_GEMINI_API_KEY unless you use separate keys on purpose. If Gemini says
# "API key not valid", the secret is missing, mistyped, or a different key than AI Studio shows.
#
# Optional secret (Edge only): GEMINI_MODEL — must be a single model id, e.g. gemini-2.0-flash
# (no "models/" prefix, no quotes). If unset, writer-tools defaults to gemini-2.0-flash and retries alternates.
# Wrong format → HTTP 400 "unexpected model name format".
